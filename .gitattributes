# Line endings.
#
# The shell scripts and the Dockerfile are executed inside a Linux
# container. If Git checks them out with CRLF on Windows, the kernel
# reads the shebang as "/usr/bin/env bash\r" and the container fails
# with "exec format error" — so they are pinned to LF regardless of
# core.autocrlf. (docker/Dockerfile also strips CR defensively, but
# this stops the problem at the source.)

# *.sh            text eol=lf
# entrypoint.sh   text eol=lf
# Dockerfile      text eol=lf
# *.yml           text eol=lf
# *.yaml          text eol=lf

# # .bat is run by cmd.exe on Windows and wants CRLF.
# *.bat           text eol=crlf

# *.py            text
# *.so            binary
venv/
__pycache__/
*.pyc
.env
.git/
.env.docker
